<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#060913"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_header_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/ios_icon_bg"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neon Premium Loader"
                    android:textColor="#C5D6FF"
                    android:textSize="14sp"
                    android:fontFamily="@font/acme"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/PremiumFileManager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Premium Subscription Ends On"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:fontFamily="@font/acme" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#8DD0FF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/acme"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY" android:textColor="#87A1C5" android:textSize="10sp" android:fontFamily="@font/acme"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#9268FF" android:textSize="22sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_h" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#8DD0FF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/acme"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOURS" android:textColor="#87A1C5" android:textSize="10sp" android:fontFamily="@font/acme"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#9268FF" android:textSize="22sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#8DD0FF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/acme"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MINUTE" android:textColor="#87A1C5" android:textSize="10sp" android:fontFamily="@font/acme"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#9268FF" android:textSize="22sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#8DD0FF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/acme"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SECOND" android:textColor="#87A1C5" android:textSize="10sp" android:fontFamily="@font/acme"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Selector"
                android:textColor="#C5D6FF"
                android:textSize="14sp"
                android:fontFamily="@font/acme" />

            <RadioGroup
                android:id="@+id/radio_group_games"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_india"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="India"
                    android:textColor="#E7F0FF"
                    android:buttonTint="#7DC3FF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />
            </RadioGroup>

            <RadioButton
                android:id="@+id/tv_hide_esp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hide ESP While Screen Recording"
                android:textSize="12sp"
                android:textColor="#A4D7FF"
                android:buttonTint="#A4D7FF"
                android:fontFamily="@font/acme" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:src="@drawable/pubg_india" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/IndiaName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battlegrounds"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="@font/acme" />

                    <TextView
                        android:id="@+id/IndiaVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version: 4.2.0"
                        android:textColor="#9AB7DE"
                        android:textSize="12sp"
                        android:fontFamily="@font/acme" />
                </LinearLayout>

                <TextView
                    android:id="@+id/installIndia"
                    android:layout_width="98dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="INSTALL"
                    android:textColor="#EAF3FF"
                    android:textStyle="bold"
                    android:background="@drawable/ios_install_button"
                    android:fontFamily="@font/acme" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_start_game"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="START GAME"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/acme"
                android:background="@drawable/ios_start_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_announcement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Premium Announcement"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#B8D6FF"
                android:fontFamily="@font/acme" />

            <TextView
                android:id="@+id/tv_announcement2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Play Safe Avoid Report | Kill Limit 10"
                android:textColor="#EAF3FF"
                android:textSize="14sp"
                android:fontFamily="@font/acme" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
