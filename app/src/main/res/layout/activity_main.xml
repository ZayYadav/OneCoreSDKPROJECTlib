<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_black_yellow">

    <FrameLayout
        android:id="@+id/particleContainerMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/ios_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="OneCore Loader"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/acme" />

            <TextView
                android:id="@+id/PremiumFileManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Elite Access Expires In"
                android:textColor="#BBD3FF"
                android:textSize="13sp"
                android:fontFamily="@font/acme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/ios_card_bg"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <TextView android:id="@+id/tv_d" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="00" android:textColor="#8FD3FF" android:textSize="24sp" android:fontFamily="@font/acme"/>
                <TextView android:id="@+id/tv_h" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="00" android:textColor="#8FD3FF" android:textSize="24sp" android:fontFamily="@font/acme"/>
                <TextView android:id="@+id/tv_m" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="00" android:textColor="#8FD3FF" android:textSize="24sp" android:fontFamily="@font/acme"/>
                <TextView android:id="@+id/tv_s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="00" android:textColor="#8FD3FF" android:textSize="24sp" android:fontFamily="@font/acme"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:background="@drawable/ios_card_bg"
                android:orientation="vertical"
                android:padding="12dp">
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BGMI India (Auto Selected)"
                    android:textColor="#E8F0FF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />

                <RadioButton
                    android:id="@+id/tv_hide_esp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Stealth Record Mode (Hide ESP)"
                    android:textColor="#9DD7FF"
                    android:buttonTint="#9DD7FF"
                    android:fontFamily="@font/acme" />
            </LinearLayout>
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/ios_card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/IndiaName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battlegrounds India"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />

                <TextView
                    android:id="@+id/IndiaVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build: v4.2.0"
                    android:textColor="#A8C4E8"
                    android:fontFamily="@font/acme" />

                <TextView
                    android:id="@+id/installIndia"
                    android:layout_width="108dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/ios_install_button"
                    android:text="DEPLOY"
                    android:textColor="#ECF4FF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />

                <TextView
                    android:id="@+id/btn_start_game"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/ios_start_button"
                    android:text="LAUNCH EXECUTION"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/ios_card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="System Broadcast"
                    android:textColor="#BBD6FF"
                    android:textStyle="bold"
                    android:fontFamily="@font/acme" />

                <TextView
                    android:id="@+id/tv_announcement2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:text="Operate smooth, avoid reports, keep session clean."
                    android:textColor="#ECF3FF"
                    android:fontFamily="@font/acme" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
